# Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git (it should be in .gitignore)

# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST/YOUR_DB_NAME?sslmode=require&channel_binding=require

# Server Configuration
PORT=3001

# Environment
NODE_ENV=development
